    firms {
        uuid id PK
        text name
        text lei
        text jurisdiction
        text tier
    }
    wsp_versions {
        uuid id PK
        uuid wsp_document_id FK
        int version_no
        text sha256
        text status
        uuid supersedes_id FK
    }
    wsp_sections {
        uuid id PK
        uuid wsp_version_id FK
        uuid parent_section_id FK
        text section_number
        ltree path
        int page_start
        text text_sha256
    }
    wsp_chunks {
        uuid id PK
        uuid wsp_section_id FK
        uuid firm_id FK
        vector embedding
        tsvector tsv
        text text_sha256
    }
    requirements {
        uuid id PK
        uuid paragraph_id FK
        text summary
        jsonb applicability_expr
    }
    control_versions {
        uuid id PK
        uuid control_id FK
        jsonb logic
        text model_id
        text prompt_sha256
        date effective_from
    }
    evaluations {
        uuid id PK
        uuid evaluation_run_id FK
        uuid control_version_id FK
        enum verdict
        enum severity
        text input_sha256
        jsonb raw_output
    }
    findings {
        uuid id PK
        uuid evaluation_id FK
        uuid firm_id FK
        enum severity
        jsonb evidence_refs
        enum status
    }
    control_section_dependency {
        uuid evaluation_id PK
        uuid wsp_section_id PK
        text section_text_sha256
        text reg_text_sha256
        text prompt_sha256
    }
    regulatory_changes {
        uuid id PK
        uuid regulation_id FK
        enum change_kind
        text source_url
        date effective_at
    }
