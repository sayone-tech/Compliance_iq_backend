    wsp_sections ||--o{ wsp_sections : parent_of
    wsp_sections ||--o{ wsp_chunks : chunked_into
    wsp_sections ||--o{ wsp_evidence : anchors

    regulations ||--o{ regulation_versions : versioned_as
    regulation_versions ||--o{ articles : contains
    articles ||--o{ paragraphs : contains
    paragraphs ||--o{ requirements : yields
    controls ||--o{ control_versions : versioned_as
    control_versions ||--o{ control_requirement_map : maps
    requirements ||--o{ control_requirement_map : mapped_by
    control_versions ||--o{ expected_evidence : specifies

