         "verified": false},
        {"id": "sw-14", "regulation": "DORA", "article": 19, "expected_verdict": "gap",
         "evidence_hint": [], "note": "major incident reporting to the competent authority",
         "verified": false}
      ]
    },
    "triad_wsp": {
      "source_pdf": "docs/research/WSP Analysis/WSP Sample.pdf",
