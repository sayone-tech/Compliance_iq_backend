# Copy to scripts/testcase_poc/.env (gitignored). Exported shell variables win over this file.
OPENAI_API_KEY=sk-...

# LangSmith -- https://smith.langchain.com -> Settings -> API Keys. Free "Developer" plan is enough.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=controliq-testcase-poc
# Required if the LangSmith account/key is EU-region (US endpoint returns 403 Forbidden):
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Qdrant (docker compose up -d qdrant). "none" = in-memory numpy retrieval, nothing persists.
QDRANT_URL=http://127.0.0.1:6333

# Models (defaults shown). Judge quality vs cost: gpt-4.1-mini ~$0.05/run, gpt-4.1 ~$0.18/run.
TC_JUDGE_MODEL=gpt-4.1-mini
TC_PARSE_MODEL=gpt-4.1-mini
TC_SUMMARY_MODEL=gpt-4.1-mini
TC_EVAL_JUDGE_MODEL=gpt-4.1
TC_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval
TC_TOP_K=10
TC_NEIGHBOUR_RADIUS=1
TC_QUERY_EXPANSION=true
TC_MAX_CONTEXT_TOKENS=16000

# Hard USD cap per run (BudgetExceeded aborts with a partial result)
TC_BUDGET_USD=1.00
